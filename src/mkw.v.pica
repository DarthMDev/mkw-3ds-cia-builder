.fvec projection[4], modelView[4], light, uvScroll
; Environment mapping for rigidly drawn menu models: rows of the bone's normal
; matrix, and (cos yaw, sin yaw, mix, 0). mix=0 keeps the vertex's own UV1.
.fvec envRow0, envRow1, envRow2, envParam
; Course-object material animation: affine rows u'=dot(row.xyz,(u,v,1)) for
; texcoord 0 (uvRow0/1) and 1 (uvRow2/3), and an RGBA multiplier on the
; vertex colour. Identity unless a draw animates its materials.
.fvec uvRow0, uvRow1, uvRow2, uvRow3, tint
; Affine applied to UV1 last (rows dot (u,v,0,1)); identity outside GX
; EnvCamera materials whose texture SRT follows the environment projection.
.fvec uv1Row0, uv1Row1
; GX colour channel 0 (retail course lighting, src/renderer_retail.cpp):
;   colour = vertex * min(light + lightDiff * df(dot(n, lightDir.xyz)), lightDir.w)
; with the diffuse function df(x) = max(x*lightFn.x + lightFn.y, lightFn.z)
; (clamp, sign or none). Other draws pass light = ambient scale, lightDiff = 0.
.fvec lightDiff, lightDir, lightFn
; GX fog: texcoord2.x = eye depth normalized to the fog start/end
; (fogParam.x * view z + fogParam.y), the coordinate of a fog ramp texture.
.fvec fogParam
; Light-texture materials: texcoord2 repeats the EnvCamera UV1 (lm_1).
.bool retailLightTexture
; Uniform branches skip work whose result cannot contribute to the draw.
.bool environmentMapped, diffuseLighting
; GPU skinning (race racers, unlit CPU-weighted course objects): inpos is
; bone-local and innormal.x holds 3 * bone index; bones holds each bone's
; 3x4 matrix rows. Skinned draws never read normals (no lighting/env).
.fvec bones[57]
.bool skinned
.constf constants(0.0, 1.0, 0.35, 0.65)
.constf colorScale(0.00392156863, 0.0, 0.0, 0.0)
.constf half(0.5, 0.5, 0.5, 0.5)
.out outpos position
.out outtc texcoord0
.out outtc1 texcoord1
.out outtc2 texcoord2
.out outcolor color
.alias inpos v0
.alias innormal v1
.alias inuv v2
.alias incolor v3
.proc main
    mov r0.xyz, inpos
    mov r0.w, constants.y
    ifu skinned
        mova a0.x, innormal.x
        dp4 r14.x, bones[a0.x], r0
        dp4 r14.y, bones[a0.x+1], r0
        dp4 r14.z, bones[a0.x+2], r0
        mov r0.xyz, r14.xyz
    .end
    dp4 r1.x, modelView[0], r0
    dp4 r1.y, modelView[1], r0
    dp4 r1.z, modelView[2], r0
    dp4 r1.w, modelView[3], r0
    ; View-space depth for fog (GX eye z).
    mov r12, r1
    dp4 r6.x, projection[0], r1
    dp4 r6.y, projection[1], r1
    dp4 r6.z, projection[2], r1
    dp4 r6.w, projection[3], r1
    mov outpos, r6
    mov r11, constants.yyyx
    mov r11.xy, inuv.xy
    mov r5, constants.xxxy
    dp3 r5.x, uvRow0, r11
    dp3 r5.y, uvRow1, r11
    add r5.xy, uvScroll.xy, r5.xy
    mov outtc, r5
    mov r11.xy, inuv.zw
    mov r5, constants.xxxy
    dp3 r5.x, uvRow2, r11
    dp3 r5.y, uvRow3, r11
    add r5.xy, uvScroll.zw, r5.xy
    ifu environmentMapped
        ; Same equation as the CPU path: m=normalize(R*n),
        ; uv1=(0.5+0.5*(cos*m.x+sin*m.z), 0.5+0.5*m.y).
        mov r0.xyz, innormal
        mov r0.w, constants.x
        dp3 r7.x, envRow0, r0
        dp3 r7.y, envRow1, r0
        dp3 r7.z, envRow2, r0
        dp3 r8.x, r7, r7
        max r8.x, colorScale.x, r8.x
        rsq r8.x, r8.x
        mul r7.xyz, r7, r8.x
        mov r9, envParam
        mul r8.x, r9.x, r7.x
        mul r8.z, r9.y, r7.z
        add r8.x, r8.x, r8.z
        mov r8.y, r7.y
        mov r10, half
        mul r8.xy, r10.xy, r8.xy
        add r8.xy, r10.xy, r8.xy
        add r8.xy, r8.xy, -r5.xy
        mul r8.xy, r9.zz, r8.xy
        add r5.xy, r5.xy, r8.xy
    .end
    dp4 r11.x, uv1Row0, r5
    dp4 r11.y, uv1Row1, r5
    mov r5.xy, r11.xy
    mov outtc1, r5
    ; Fog coordinate: normalized GX eye depth (clamped by the ramp texture).
    mov r13, constants.xxxy
    mul r13.x, fogParam.x, r12.z
    add r13.x, fogParam.y, r13.x
    mov r13.y, half.y
    ifu diffuseLighting
        mov r0.xyz, innormal
        mov r0.w, constants.x
        dp4 r1.x, modelView[0], r0
        dp4 r1.y, modelView[1], r0
        dp4 r1.z, modelView[2], r0
        dp3 r2.x, r1, r1
        max r2.x, colorScale.x, r2.x
        rsq r2.x, r2.x
        mul r1.xyz, r1, r2.x
        ; GX colour channel: light + lightDiff * df(n.L), saturated at lightDir.w.
        dp3 r2.x, lightDir, r1
        mul r2.x, lightFn.x, r2.x
        add r2.x, lightFn.y, r2.x
        max r2.x, lightFn.z, r2.x
        mul r3, lightDiff, r2.xxxx
        add r3, light, r3
    .else
        mov r3, light
    .end
    min r3, lightDir.wwww, r3
    mul r4, colorScale.x, incolor
    ; PICA requires all lanes of each output, including unused ones, written.
    mul r4, r4, r3
    mul r4, tint, r4
    ifu retailLightTexture
        ; lm_1 shares the EnvCamera coordinates of lm_0 (texture unit 1).
        mov outtc2, r5
    .else
        mov outtc2, r13
    .end
    mov outcolor, r4
    end
.end
